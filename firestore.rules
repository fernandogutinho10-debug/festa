rules_version = '2';
// Regras de segurança da Festa na Casa.
// TROQUE o e-mail abaixo pelo e-mail do organizador (o mesmo do config.js).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "SEU_EMAIL_AQUI@gmail.com";
    }
    function signedIn() { return request.auth != null; }

    // Informações da festa e fotos: todos leem, só o organizador altera
    match /event/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /photos/{id} { allow read: if true; allow write: if isAdmin(); }
    match /drinks/{id} { allow read: if true; allow write: if isAdmin(); }

    // Presença: cada pessoa só mexe na própria; o organizador mexe em todas
    match /rsvps/{uid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.plan in [25, 50]);
    }

    // Confirmação de pagamento: só o organizador
    match /confirmations/{uid} { allow read: if true; allow write: if isAdmin(); }

    // Itens: o organizador cria/remove; convidados só pegam item livre ou soltam o próprio
    match /items/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedName', 'claimedAt'])
        && ((resource.data.claimedBy == null && request.resource.data.claimedBy == request.auth.uid)
          || (resource.data.claimedBy == request.auth.uid && request.resource.data.claimedBy == null)));
    }

    // Votos: cada pessoa só o próprio, no máximo 3 escolhas
    match /votes/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && (request.method == 'delete' || (request.resource.data.picks is list && request.resource.data.picks.size() <= 3));
    }
  }
}
